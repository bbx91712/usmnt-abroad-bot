# API-Football / API-Sports key
RAPIDAPI_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Resend (email)
RESEND_API_KEY=
RESEND_FROM=newsletter@usmntabroad.example
RESEND_TO=subscriber1@example.com,subscriber2@example.com

# X/Twitter (optional; keep TWITTER_POST_ENABLED=0 until ready)
TWITTER_POST_ENABLED=0
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Dry-run / mock controls (set DRY_RUN=1 for no live API calls or sends)
DRY_RUN=1
MOCK_DATA=1
